# Gmail OAuth
GMAIL_TOKEN_PATH=data/token.json
GMAIL_CREDENTIALS_PATH=credentials.json

# Classification
CONFIDENCE_THRESHOLD=60
INVOICE_SAVE_FOLDER=data/invoices

# State files
PROCESSED_IDS_PATH=data/processed_ids.json
LAST_HISTORY_ID_PATH=data/last_history_id.json
EXCEPTION_QUEUE_PATH=data/exception_queue.json

# GCP Pub/Sub
PUBSUB_TOPIC=projects/invoice-and-po-processing/topics/invoice

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security — MIME validation
MIME_VALIDATION_ENABLED=true
MAX_ATTACHMENT_SIZE_MB=25
ALLOWED_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/zip
QUARANTINE_PATH=data/quarantine.json

# Security — ClamAV (use CLAMAV_HOST=clamav in Docker)
MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT_SEC=30
MALWARE_SCAN_FAIL_OPEN=false

# =============================================================================
# OCR — GPT-4 Vision (PRODUCTION — single source of truth)
# Mail ingest and run_vision_ocr_job read ONLY this project-root .env.
# Do not rely on ocr_module/.env for the app.
# =============================================================================
OCR_ENABLED=true
OCR_OUTPUT_DIR=data/extracted
OCR_OPENAI_API_KEY=
OCR_MODEL_NAME=gpt-4o-2024-08-06
OCR_MAX_RETRIES=3
OCR_REQUEST_TIMEOUT_SECONDS=60
OCR_MAX_IMAGE_DIMENSION=2000
OCR_PDF_RENDER_DPI=200
OCR_LOW_CONFIDENCE_THRESHOLD=0.6
OCR_GSTIN_FOCUSED_PASS=true

# =============================================================================
# GSTIN live validation (https://gstincheck.co.in/)
# GET https://sheet.gstincheck.co.in/check/{API_KEY}/{GSTIN}
# Invalid vendor/buyer GSTIN → exception queue for manual review
# =============================================================================
GSTIN_API_VALIDATION_ENABLED=true
GSTIN_API_KEY=
GSTIN_API_BASE_URL=https://sheet.gstincheck.co.in
GSTIN_API_TIMEOUT_SEC=30
