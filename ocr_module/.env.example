# LEGACY / local experiments only.
# Production mail ingest loads OCR_* from the PROJECT ROOT .env:
#   ../.env
# Prefer:  python ../scripts/sync_ocr_env.py
#
OCR_OPENAI_API_KEY=
OCR_MODEL_NAME=gpt-4o-2024-08-06
OCR_MAX_RETRIES=3
OCR_REQUEST_TIMEOUT_SECONDS=60
OCR_MAX_IMAGE_DIMENSION=2000
OCR_PDF_RENDER_DPI=200
OCR_LOW_CONFIDENCE_THRESHOLD=0.6
OCR_GSTIN_FOCUSED_PASS=true
